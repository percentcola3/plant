{
  "name": "plant",
  "version": "0.2.12",
  "description": "Plant：让想法生长为界面的 AI UI 设计工具",
  "private": true,
  "type": "module",
  "main": "./out/main/index.js",
  "scripts": {
    "brand:icons": "node scripts/generate-brand-icons.mjs",
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:web": "vue-tsc --noEmit -p tsconfig.web.json",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "lint": "echo 'lint placeholder'",
    "test": "vitest run",
    "test:watch": "vitest",
    "postinstall": "electron-rebuild -f -w node-pty",
    "setup:bundled-git": "node scripts/setup-bundled-git.mjs",
    "check:packaged-zg": "node scripts/check-packaged-zg.cjs",
    "pack:dir": "electron-vite build && electron-builder --dir",
    "dist": "electron-vite build && electron-builder"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.0.4",
    "@types/node": "^22.20.0",
